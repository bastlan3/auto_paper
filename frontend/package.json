{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev": "concurrently \"npm run start:backend:dev\" \"wait-on http://localhost:8000 && npm run start:frontend\"",
    "start:frontend": "next dev",
    "start:backend": "cd .. && uvicorn server:app",
    "start:backend:dev": "cd .. && uvicorn server:app --reload",
    "build": "next build",
    "build:backend": "node build-backend.js",
    "export": "next export",
    "dist": "npm run build:backend && npm run build && npm run export && electron-builder"
  },
  "dependencies": {
    "next": "^14.2.33",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^28.2.3",
    "electron-builder": "^24.13.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  }
}
